# Copy to .env (read by both `docker compose` and Next.js), then edit.
# Everything below can also be set later in the app's Settings page.

# --- Meilisearch -------------------------------------------------------------
MEILISEARCH_HOST=http://127.0.0.1:7700
# Used as MEILI_MASTER_KEY by docker-compose.yml. Change it to any long random string.
MEILISEARCH_API_KEY=cjk-studio-local-master-key

# --- LLM providers (fill in any of them) --------------------------------------
# Default provider when several are configured: openai | anthropic | google |
# openrouter | deepseek | qwen | kimi | zhipu | doubao | siliconflow | ollama | custom
LLM_PROVIDER=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
MOONSHOT_API_KEY=
ZHIPU_API_KEY=
ARK_API_KEY=
SILICONFLOW_API_KEY=

# Each provider also accepts <PREFIX>_MODEL and <PREFIX>_BASE_URL, e.g.
# ANTHROPIC_MODEL=claude-opus-5-5
# DEEPSEEK_MODEL=deepseek-chat

# Local Ollama (OpenAI-compatible endpoint)
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=qwen3:8b

# Any other OpenAI-compatible server (LM Studio, vLLM, one-api, …)
# OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:1234/v1
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_MODEL=

# --- Embeddings (vectors for knowledge bases) ----------------------------------
# builtin = Qwen3-Embedding-0.6B (GGUF, ~640 MB) running in-process via llama.cpp;
#           downloaded on first use into .data/models/ (or copy the file there).
# remote  = any OpenAI-compatible /v1/embeddings endpoint (Ollama, llama.cpp,
#           TEI, vLLM, DashScope text-embedding-v4, SiliconFlow …).
EMBEDDING_ENGINE=builtin
# Model download source: huggingface | hf-mirror | modelscope | custom
# EMBEDDING_MODEL_SOURCE=modelscope
# EMBEDDING_MODEL_URL=https://example.com/Qwen3-Embedding-0.6B-Q8_0.gguf
# Setting HF_ENDPOINT=https://hf-mirror.com also selects the hf-mirror source.
# EMBEDDING_GPU=false            # force CPU (default: auto-detect Metal/CUDA/Vulkan)
# EMBEDDING_CONTEXT_SIZE=2048

# Remote engine
# EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
# EMBEDDING_MODEL=qwen3-embedding:0.6b
# EMBEDDING_API_KEY=
# EMBEDDING_BATCH_SIZE=10
# Qwen3 query instruction (only prepended to queries; clear it for non-Qwen models)
# EMBEDDING_QUERY_INSTRUCTION=Given a web search query, retrieve relevant passages that answer the query

# --- OCR (built-in PaddleOCR, runs in-process on ONNX Runtime) --------------------
# OCR_ENABLED=true
# small (default; Chinese, English, Japanese) | medium | tiny | korean
# OCR_MODEL=small
# auto (Hugging Face → ModelScope → hf-mirror → PyPI) | huggingface | modelscope
# | hf-mirror | pypi | custom
# OCR_MODEL_SOURCE=auto
# OCR_MODEL_BASE_URL=          # for custom: same layout as ppu-paddle-ocr-models
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple   # used by the pypi source

# --- App data --------------------------------------------------------------------
# Settings, knowledge-base registry, sync manifests, uploads and models.
# APP_DATA_DIR=.data
