# Copy to .env (read by both `docker compose` and Next.js), then edit.
# Everything below can also be set later in the app's Settings page.

# --- Meilisearch -------------------------------------------------------------
MEILISEARCH_HOST=http://127.0.0.1:7700
# Used as MEILI_MASTER_KEY by docker-compose.yml. Change it to any long random string.
MEILISEARCH_API_KEY=cjk-studio-local-master-key

# --- LLM providers (fill in any of them) --------------------------------------
# Default provider when several are configured: openai | anthropic | google |
# openrouter | deepseek | qwen | kimi | zhipu | doubao | siliconflow | ollama | custom
LLM_PROVIDER=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
MOONSHOT_API_KEY=
ZHIPU_API_KEY=
ARK_API_KEY=
SILICONFLOW_API_KEY=

# Each provider also accepts <PREFIX>_MODEL and <PREFIX>_BASE_URL, e.g.
# ANTHROPIC_MODEL=claude-opus-5-5
# DEEPSEEK_MODEL=deepseek-chat

# Local Ollama (OpenAI-compatible endpoint)
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=qwen3:8b

# Any other OpenAI-compatible server (LM Studio, vLLM, one-api, …)
# OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:1234/v1
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_MODEL=
